---
import ProjectSection from '@/components/projects/ProjectSection.astro'
import PageLayout from '@/layouts/CommonPage.astro'
import { projectTracks } from '@/data/projects'

const headings = projectTracks.map(({ id, title }) => ({ depth: 2, slug: id, text: title }))
---

<PageLayout title='项目' description='游戏、图形、AI 与 Web 项目' {headings}>
  <section class='not-prose mb-10' aria-label='GitHub Activities'>
    <p class='mb-4 text-muted-foreground'>GitHub Activities</p>
    <a href='https://github.com/entropy622' class='block rounded-2xl border p-5' target='_blank' rel='noreferrer' aria-label='查看 Aentro 的 GitHub 活跃度'>
      <div class='overflow-x-auto'>
        <img src='https://ghchart.rshah.org/659eb9/entropy622' alt='Aentro 的 GitHub 贡献记录' width='728' height='104' loading='lazy' class='min-w-[600px] w-full' />
      </div>
      <div class='mt-5 flex items-center gap-3'>
        <img src='/images/avatar.png' alt='' width='40' height='40' class='rounded-full' />
        <span>Aentro</span>
      </div>
    </a>
  </section>
  {projectTracks.map((track) => (
    <>
      <h2 id={track.id}>{track.title}</h2>
      <ProjectSection projects={track.projects} />
    </>
  ))}
</PageLayout>
