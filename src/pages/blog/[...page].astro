---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, getUniqueTagsWithCount } from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'

import PageLayout from '@/layouts/BaseLayout.astro'
import DirectoryHeader from '@/components/DirectoryHeader.astro'
import '@/assets/styles/directories.css'
import config from '@/site-config'
import { sortPublicPosts } from '@/utils/blog'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortPublicPosts(await getBlogCollection())
  const uniqueTags = getUniqueTagsWithCount(collections).map(([tag]) => tag)
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags, collectionsCount: collections.length }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
}

const { page, uniqueTags, collectionsCount } = Astro.props
const meta = { description: '公开文章与学习记录', title: 'Blog' }
---

<PageLayout {meta}>
  <main class='directory-page directory-blog'>
    <DirectoryHeader title='文章' label='BLOG' number='01' description='公开文章与学习记录' />
    <div class='directory-blog-grid'>
      <section aria-label='Blog posts list' class='animate' id='content'>
        <div class='directory-blog-meta'>
          共 {collectionsCount} 篇公开文章 · 第 {page.currentPage} 页
        </div>
        {page.data.length === 0 ? <p>还没有文章。</p> : <ul class='flex flex-col gap-y-4 text-start'>{page.data.map((post) => <PostPreview {post} detailed />)}</ul>}
        <Paginator
          {...(page.url.prev && { prevUrl: { text: '← 上一页', url: page.url.prev } })}
          {...(page.url.next && { nextUrl: { text: '下一页 →', url: page.url.next } })}
        />
      </section>
      {!!uniqueTags.length && <aside class='animate' id='sidebar'>
        <h2 class='mb-4 flex items-center text-lg font-medium'><Icon name='tag-2' class='me-2' />标签</h2>
        <ul class='flex flex-wrap gap-2'>{uniqueTags.slice(0, 50).map((tag) => <li><Button title={tag} href={`/tags/${tag}`} variant='pill' /></li>)}</ul>
        <a class='mt-4 block text-sm hover:text-primary' href='/tags'>查看全部 →</a>
      </aside>}
    </div>
  </main>
</PageLayout>
