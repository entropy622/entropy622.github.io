---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { getBlogCollection, getUniqueTagsWithCount } from 'astro-pure/server'

import BlogDirectory from '@/components/blog/BlogDirectory.astro'
import config from '@/site-config'
import { postKind, sortPublicPosts } from '@/utils/blog'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortPublicPosts(await getBlogCollection())
  const uniqueTags = getUniqueTagsWithCount(collections)
  const kindCount = {
    tech: collections.filter((post) => postKind(post) === 'tech').length,
    daily: collections.filter((post) => postKind(post) === 'daily').length
  }
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags, kindCount, collectionsCount: collections.length }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: [string, number][]
  kindCount: { tech: number; daily: number }
  collectionsCount: number
}

const { page, uniqueTags, kindCount, collectionsCount } = Astro.props
---

<BlogDirectory {page} {uniqueTags} {kindCount} {collectionsCount} />
