---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import { getBlogCollection, getUniqueTagsWithCount } from 'astro-pure/server'

import PageLayout from '@/layouts/BaseLayout.astro'
import PostEntry from '@/components/blog/PostEntry.astro'
import DirectoryHeader from '@/components/DirectoryHeader.astro'
import '@/assets/styles/directories.css'
import config from '@/site-config'
import { postKind, sortPublicPosts } from '@/utils/blog'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortPublicPosts(await getBlogCollection())
  const uniqueTags = getUniqueTagsWithCount(collections)
  const kindCount = {
    tech: collections.filter((post) => postKind(post) === 'tech').length,
    daily: collections.filter((post) => postKind(post) === 'daily').length
  }
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags, kindCount, collectionsCount: collections.length }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: [string, number][]
  kindCount: { tech: number; daily: number }
  collectionsCount: number
}

const { page, uniqueTags, kindCount, collectionsCount } = Astro.props
const meta = { description: '技术笔记与日常记录', title: 'Blog' }
---

<PageLayout {meta}>
  <main class='directory-page directory-blog'>
    <DirectoryHeader title='文章' label='BLOG' number='01' description='技术笔记与日常记录，按时间倒序归档。' />
    <div class='directory-blog-grid'>
      <section aria-label='文章列表' class='animate' id='content'>
        <div class='directory-blog-meta'>
          <span>共 {collectionsCount} 篇公开文章</span>
          <span>第 {page.currentPage} / {page.lastPage} 页</span>
        </div>
        {page.data.length === 0 ? <p>还没有文章。</p> : <ol class='rl-entries'>{page.data.map((post) => <PostEntry {post} />)}</ol>}
        <Paginator
          {...(page.url.prev && { prevUrl: { text: '← 上一页', url: page.url.prev } })}
          {...(page.url.next && { nextUrl: { text: '下一页 →', url: page.url.next } })}
        />
      </section>
      <aside class='animate directory-blog-side' id='sidebar'>
        <div class='directory-side-block'>
          <h2>分区</h2>
          <dl class='directory-kinds'>
            <div class='is-tech'><dt>技术笔记</dt><dd>{String(kindCount.tech).padStart(2, '0')}</dd></div>
            <div class='is-daily'><dt>日常</dt><dd>{String(kindCount.daily).padStart(2, '0')}</dd></div>
          </dl>
        </div>
        {!!uniqueTags.length && (
          <div class='directory-side-block'>
            <h2>标签</h2>
            <ul class='directory-tags'>
              {uniqueTags.slice(0, 50).map(([tag, count]) => <li><a href={`/tags/${tag}`}>{tag}<span>{count}</span></a></li>)}
            </ul>
            <a class='directory-side-more' href='/tags'>全部标签 <span aria-hidden='true'>→</span></a>
          </div>
        )}
      </aside>
    </div>
  </main>
</PageLayout>
