---
import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/DirectoryLayout.astro'
import { profile } from '@/data/profile'

const headings = [
  { depth: 2, slug: 'contact', text: '找到我' }
]
---

<PageLayout title='关于我' label='ABOUT' number='04' description={`${profile.alias} / ${profile.name}`} metaDescription={profile.bio} {headings}>
  <p class='lead'>{profile.bio}</p>

  <h2 id='contact'>找到我</h2>
  <div class='about-social'>
    {profile.social.map(({ icon, label, href }) => (
      <a class='rl-btn' href={href} target='_blank' rel='noreferrer'>
        <span class='about-social-label'><Icon name={icon} class='size-5' />{label}</span>
        <span aria-hidden='true'>↗</span>
      </a>
    ))}
  </div>
</PageLayout>
