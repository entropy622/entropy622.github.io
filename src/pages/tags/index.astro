---
import { getBlogCollection, getUniqueTagsWithCount } from 'astro-pure/server'
import DirectoryHeader from '@/components/DirectoryHeader.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import '@/assets/styles/directories.css'
import { filterPublicPosts } from '@/utils/blog'

const allPosts = filterPublicPosts(await getBlogCollection())
const allTags = getUniqueTagsWithCount(allPosts)

const meta = {
  description: "A list of all the topics I've written about in my posts",
  title: 'All Tags'
}
---

<PageLayout {meta}>
  <main class='directory-page directory-tags'>
    <DirectoryHeader title='标签' label='TAGS' number='05' description='按主题索引全部公开文章' />
    <div id='content' class='animate'>
      {
        allTags.length > 0 ? (
          <ul class='tag-index'>
            {allTags.map(([tag, val], index) => (
              <li>
                <a href={`/tags/${tag}`}>
                  <span class='tag-index-id' aria-hidden='true'>T-{String(index + 1).padStart(2, '0')}</span>
                  <b>{tag}</b>
                  <span class='tag-index-count'>{String(val).padStart(2, '0')}</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p>还没有标签。</p>
        )
      }
    </div>
  </main>
</PageLayout>

<style>
  .tag-index { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: .6rem; list-style: none; padding: 0; margin: 0; }
  .tag-index a { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .8rem; padding: 1rem; border: 1px solid var(--rl-line-strong); background: var(--rl-glass); transition: background .2s, color .2s; }
  .tag-index a:hover { background: var(--rl-ink); color: var(--rl-paper); border-color: var(--rl-ink); }
  .tag-index-id { font: 500 .55rem/1 var(--rl-mono); letter-spacing: .12em; color: var(--rl-accent-ink); }
  .tag-index b { font-weight: 700; overflow-wrap: anywhere; }
  .tag-index-count { font: 300 1.3rem/1 var(--rl-mono); }
</style>
