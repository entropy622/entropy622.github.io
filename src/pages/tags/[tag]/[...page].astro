---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, getUniqueTags } from 'astro-pure/server'
import DirectoryHeader from '@/components/DirectoryHeader.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import '@/assets/styles/directories.css'
import config from '@/site-config'
import { sortPublicPosts } from '@/utils/blog'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPostsByDate = sortPublicPosts(await getBlogCollection())
  const uniqueTags = getUniqueTags(allPostsByDate)

  return uniqueTags.flatMap((tag) => {
    const filterPosts = allPostsByDate.filter((post) => post.data.tags.includes(tag))
    return paginate(filterPosts, {
      pageSize: config.content.blogPageSize,
      params: { tag }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props
const { tag } = Astro.params

const meta = {
  description: `View all posts with the tag - ${tag}`,
  title: `Tag: ${tag}`
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← Previous Tags`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `Next Tags →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <main class='directory-page directory-blog'>
    <DirectoryHeader title={`#${tag}`} label='TAG' number='05' description={`标签「${tag}」下的全部文章`} />
    <section id='content' class='animate' aria-label='Blog post list'>
      <div class='directory-blog-meta'>共 {page.total} 篇 · 第 {page.currentPage} 页 · <a href='/tags'>全部标签 →</a></div>
      <ul class='flex flex-col gap-y-3 text-start'>
        {page.data.map((post) => <PostPreview {post} detailed />)}
      </ul>
      <Paginator {...paginationProps} />
    </section>
  </main>
</PageLayout>
