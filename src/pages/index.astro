---
import { Image } from 'astro:assets'
import { getBlogCollection } from 'astro-pure/server'
import avatar from '@/assets/avatar.png'
import station from '@/assets/field-station.webp'
import RhineTerminal from '@/components/home/RhineTerminal.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import { profile } from '@/data/profile'
import { projectTracks } from '@/data/projects'
import { postKind, postKindLabel, sortPublicPosts, type BlogPost } from '@/utils/blog'
import '@/assets/styles/home-dossier.css'

const [cover, ...entries] = sortPublicPosts(await getBlogCollection())
const dateOf = (post: BlogPost) => post.data.updatedDate ?? post.data.publishDate
const dateLabel = (post: BlogPost) => dateOf(post).toISOString().slice(0,10).replaceAll('-', '.')
// When a paper title opens a bilingual headline, set its translation note on a separate line.
const headline = cover?.data.title.match(/^([A-Za-z][A-Za-z0-9 :,-]{8,}?)\s+([\p{Script=Han}].*)$/u)
const selected = ['Blender Copilot', 'Unity 仿崩铁卡通渲染']
const projects = selected.flatMap(name => projectTracks.flatMap(track => track.projects.filter(p => p.name === name)))
---

<PageLayout meta={{ title: '首页' }}>
  <main class='journal'>
    <header class='mast'>
      <div class='mast-name'><i aria-hidden='true'></i><b>{profile.alias}的手记</b><span>FIELD JOURNAL</span></div>
      <a href='/about' class='author'><Image src={avatar} width={52} height={52} alt='' loading='eager' />关于 Aentro <span aria-hidden='true'>↗</span></a>
    </header>
    {cover && <article class='cover'>
      <a class='cover-link' href={`/blog/${cover.id}`} aria-labelledby='cover-title'>
        <figure class='station'>
          <Image src={station} alt='' widths={[640, 960, 1320]} sizes='(max-width: 700px) 100vw, 620px' loading='eager' fetchpriority='high' />
          <figcaption aria-hidden='true'>PL. 01 <i></i> 野外观测站</figcaption>
        </figure>
        <div class='cover-type'>
          <div class='cover-meta'><strong>最新文章</strong><span>{postKindLabel[postKind(cover)]}</span><time datetime={dateOf(cover).toISOString()}>{dateLabel(cover)}</time></div>
          <h1 id='cover-title'><span>{headline?.[1] ?? cover.data.title}</span>{headline && <> <small>{headline[2]}</small></>}</h1>
          <span class='cover-read'>阅读文章 <span aria-hidden='true'>→</span></span>
        </div>
      </a>
    </article>}

    <div class='desk'>
      <section class='notes' aria-labelledby='notes-title'>
        <header class='section-line'><h2 id='notes-title'>近期手记</h2><a href='/blog'>全部文章 <span aria-hidden='true'>→</span></a></header>
        <ol class='note-list'>
          {entries.slice(0, 4).map(post => <li>
            <a href={`/blog/${post.id}`}>
              <time datetime={dateOf(post).toISOString()}>{dateLabel(post)}</time>
              <h3>{post.data.title}</h3>
              <span class='note-arrow' aria-hidden='true'>↗</span>
            </a>
          </li>)}
        </ol>
        <nav class='browse' aria-label='按分类浏览'><span>分类</span><a href='/blog/category/tech'>技术笔记 ↗</a><a href='/blog/category/daily'>日常 ↗</a></nav>
      </section>

      <section class='workbench' aria-labelledby='work-title'>
        <header class='section-line'><h2 id='work-title'>作品台</h2><a href='/projects'>全部作品 <span aria-hidden='true'>→</span></a></header>
        {projects.map((project, index) => <a href={project.links[0].href} class='work'>
          <span class:list={['work-icon', { 'is-render': index === 1 }]} aria-hidden='true'>
            {index === 0 ? <svg viewBox='0 0 64 64' fill='none' stroke='currentColor' stroke-width='1.8'><path d='m32 8 20 12v24L32 56 12 44V20Zm0 24 20-12M32 32 12 20m20 12v24M22 14l20 12v12L22 50M42 14 22 26v12l20 12'/></svg> : <svg viewBox='0 0 64 64' fill='none' stroke='currentColor' stroke-width='1.5'><circle cx='32' cy='32' r='20'/><path d='M29 12c20 9 19 31 1 40 29-1 29-38-1-40Z' fill='currentColor'/><ellipse cx='32' cy='32' rx='30' ry='8' transform='rotate(-27 32 32)'/></svg>}
          </span>
          <div><h3>{project.name}</h3><p>{index === 0 ? '让 LLM 编辑 Blender 蓝图' : '在 URP 中复现角色光影'}</p></div>
          <span class='work-arrow' aria-hidden='true'>↗</span>
        </a>)}
      </section>
    </div>
    <section class='terminal-slot' aria-label='交互式终端'><RhineTerminal /></section>
  </main>
</PageLayout>
