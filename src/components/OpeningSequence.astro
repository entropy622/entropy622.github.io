<!-- Decorative, fail-open introduction. Logo motion adapted from LBEILC/RhineLabUI src/boot*.ts.
     Code license: /licenses/RhineLabUI-MIT.txt. Brand rights remain with their owners. -->
<div id='opening-sequence' aria-hidden='true'>
  <div class='op-brand'>
    <b>AENTRO</b>
    <span>PERSONAL BLOG</span>
    <span>TERMINAL <strong>OS</strong></span>
  </div>
  <svg class='op-logo' viewBox='0 0 310 185' fill='none'>
    <path
      class='op-contour'
      d='M295 73C295 41 273 15 240 15C221 15 207 23 192 38C186 43 181 47 176 52C127 96 103 128 70 128C38 128 15 101 15 70C15 39 37 15 70 15C103 15 127 48 156 75C182 99 208 128 240 128C273 128 295 105 295 73Z'
      stroke='currentColor'
      stroke-width='0'
      pathLength='1'
    />
    <path class='op-plus' d='M44 70h50M69 45v50' stroke='var(--rl-accent)' stroke-width='15' />
    <path class='op-minus' d='M-7.5 0h15' stroke='var(--rl-accent)' stroke-width='15' />
    <text class='op-letters' x='66' y='174'></text>
  </svg>
  <div class='op-progress'>
    <i><b></b></i>
    <span><em>LOADING</em><em class='op-percent'>000%</em></span>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.getElementById('opening-sequence')
    if (!root) return
    try {
      const release = () => document.dispatchEvent(new Event('aentro-opening-done'))
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('aentro-opening-seen')) {
        root.remove()
        release()
        return
      }
      sessionStorage.setItem('aentro-opening-seen', '1')
      // The overlay stays opaque through the hold, so the page backdrop can wait.
      document.documentElement.classList.add('rl-booting')

      const SKIP_TO = 2.8
      const ERASE_END = 3.55
      const FADE_AT = 3.15
      const END = 4.05
      const contour = root.querySelector('.op-contour')
      const plus = root.querySelector('.op-plus')
      const minus = root.querySelector('.op-minus')
      const letters = root.querySelector('.op-letters')
      const brand = Array.from(root.querySelectorAll('.op-brand > *'))
      const progress = root.querySelector('.op-progress')
      const bar = root.querySelector('.op-progress b')
      const percent = root.querySelector('.op-percent')

      const clamp = (v) => (v < 0 ? 0 : v > 1 ? 1 : v)
      const p = (t, a, b) => clamp((t - a) / (b - a))
      const lerp = (a, b, k) => a + (b - a) * k
      const expoOut = (k) => (k >= 1 ? 1 : 1 - Math.pow(2, -10 * k))
      const quartInOut = (k) => (k < 0.5 ? 8 * k ** 4 : 1 - (-2 * k + 2) ** 4 / 2)
      const smooth = (k) => k * k * (3 - 2 * k)
      const spring = (k) => (k >= 1 ? 1 : 1 - Math.exp(-6.5 * k) * Math.cos(10.5 * k))

      const frame = (t) => {
        // One continuous contour: its head outruns its tail, leaving the mark's small printed gap.
        const erase = smooth(p(t, 2.8, ERASE_END))
        const head = 1.184 * expoOut(p(t, 0.25, 1.75))
        const tail = 0.2115 * expoOut(p(t, 0.32, 1.82))
        // The drawn mark holds still from 1.85s to 2.8s, so leave its geometry alone.
        if (t < 1.85 || erase) {
          const start = erase ? lerp(0.1835, 0.9365, erase) + 0.0275 : tail
          const len = erase ? 0.9725 * (1 - erase) : Math.max(0, head - tail)
          contour.style.strokeDasharray = `${len} ${1 - len}`
          contour.style.strokeDashoffset = String(-start)
          if (t < 0.6) contour.setAttribute('stroke-width', String(26 * expoOut(p(t, 0.25, 0.6))))
        }

        const pop = p(t, 1.0, 1.7)
        const turn = p(t, 1.35, 2.1)
        const out = smooth(p(t, 3.0, ERASE_END))
        if (t < 2.15 || out) {
          const scale = spring(pop) * (1 - out)
          plus.style.opacity = minus.style.opacity = pop > 0 ? '1' : '0'
          plus.setAttribute('transform',
            `translate(${lerp(155, 72.6, expoOut(pop))} 70) rotate(${-90 * spring(turn)}) scale(${scale}) translate(-69 -70)`)
          const mw = lerp(15, 46, expoOut(turn))
          minus.setAttribute('d', `M${-mw / 2} 0h${mw}`)
          minus.setAttribute('transform', `translate(${lerp(155, 237.1, expoOut(pop))} 70) scale(${scale})`)
          letters.style.opacity = String(1 - out)
        }

        const text = t < 1.4 ? '' : 'AENTRO'.slice(0, 1 + Math.floor(p(t, 1.4, 2.0) * 5))
        if (letters.textContent !== text) letters.textContent = text

        // Loading runs in two surges with a short stall between them, then completes before the hold.
        if (t < 2.55 || out) {
          const load = 0.62 * expoOut(p(t, 0.3, 1.3)) + 0.38 * quartInOut(p(t, 1.5, 2.5))
          bar.style.transform = `scaleX(${load})`
          const shown = `${String(Math.round(load * 100)).padStart(3, '0')}%`
          if (percent.textContent !== shown) percent.textContent = shown
          progress.style.opacity = String(p(t, 0.2, 0.45) * (1 - out))
        }

        if (t < 1.9) brand.forEach((node, i) => {
          const k = p(t, 0.5 + i * 0.1, 1.5 + i * 0.1)
          node.style.opacity = String(p(t, 0.5 + i * 0.1, 0.75 + i * 0.1))
          node.style.transform = `translateX(${48 * (1 - expoOut(k))}px)`
        })
      }

      let begin = 0
      let offset = 0
      let raf = 0
      let fading = false
      let finished = false
      const now = () => (performance.now() - begin) / 1000 + offset
      const skip = () => {
        if (begin && now() < SKIP_TO) offset += SKIP_TO - now()
      }
      const finish = () => {
        if (finished) return
        finished = true
        cancelAnimationFrame(raf)
        removeEventListener('keydown', skip, true)
        root.remove()
        document.documentElement.classList.remove('rl-booting')
        release()
      }
      const tick = (ms) => {
        if (!begin) begin = ms
        const t = now()
        // Paint the page once while the overlay is still opaque, then fade on the compositor.
        if (t >= 2.6) document.documentElement.classList.remove('rl-booting')
        if (t >= FADE_AT && !fading) {
          fading = true
          root.style.transition = 'opacity .9s cubic-bezier(.4, 0, .2, 1)'
          root.style.opacity = '0'
        }
        if (t < ERASE_END) frame(t)
        if (t >= END) finish()
        else raf = requestAnimationFrame(tick)
      }

      root.classList.add('is-playing')
      frame(0)
      raf = requestAnimationFrame(tick)
      root.addEventListener('pointerdown', skip)
      addEventListener('keydown', skip, true)
      setTimeout(finish, END * 1000 + 2500)
      document.addEventListener('astro:before-swap', finish, { once: true })
    } catch {
      root.remove()
      document.documentElement.classList.remove('rl-booting')
      document.dispatchEvent(new Event('aentro-opening-done'))
    }
  })()
</script>

<style>
  #opening-sequence {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 10000;
    place-items: center;
    cursor: pointer;
    background:
      radial-gradient(ellipse at 50% 48%, color-mix(in srgb, var(--rl-paper) 90%, #fff) 0%, var(--rl-paper) 72%),
      var(--rl-paper);
    color: var(--rl-ink);
    user-select: none;
  }
  :global(html.dark) #opening-sequence {
    background: radial-gradient(ellipse at 50% 48%, #1d1d1b 0%, var(--rl-paper) 72%), var(--rl-paper);
  }
  #opening-sequence.is-playing { display: grid; will-change: opacity; contain: layout paint; }

  .op-brand {
    position: absolute;
    left: clamp(20px, 4vw, 52px);
    top: clamp(20px, 4.5vh, 48px);
    display: grid;
    line-height: 1.15;
    font-family: var(--rl-sans);
  }
  .op-brand > * { opacity: 0; }
  .op-brand b { font-size: clamp(22px, 2.6vw, 32px); font-weight: 800; letter-spacing: .02em; }
  .op-brand span { font-size: clamp(10px, 1vw, 13px); font-weight: 700; letter-spacing: .08em; }
  .op-brand span:last-child { font-size: clamp(14px, 1.5vw, 19px); font-weight: 500; letter-spacing: .12em; }
  .op-brand strong { font-weight: 800; color: var(--rl-accent); }

  .op-progress {
    position: absolute;
    left: 50%;
    top: calc(50% + clamp(78px, 11vw, 118px));
    width: clamp(180px, 26vw, 280px);
    transform: translateX(-50%);
    opacity: 0;
  }
  .op-progress i { display: block; height: 2px; background: var(--rl-line-strong); }
  .op-progress b { display: block; height: 100%; background: var(--rl-accent); transform: scaleX(0); transform-origin: left; }
  .op-progress span {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    font-family: var(--rl-mono);
    font-size: 10px;
    letter-spacing: .16em;
    color: color-mix(in srgb, var(--rl-ink) 55%, transparent);
  }
  .op-progress em { font-style: normal; }

  .op-logo { width: clamp(180px, 26vw, 280px); overflow: visible; }
  .op-contour { stroke-dasharray: 0 1; }
  .op-plus, .op-minus { opacity: 0; }
  .op-letters {
    fill: currentColor;
    font-family: var(--rl-sans);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 22px;
  }

  @media (prefers-reduced-motion: reduce) { #opening-sequence.is-playing { display: none; } }
</style>
