<!-- Decorative, fail-open introduction. Never locks scrolling or focus. -->
<div id='opening-sequence' aria-hidden='true' inert>
  <span class='op-corner tl'></span><span class='op-corner tr'></span><span class='op-corner bl'></span><span class='op-corner br'></span>
  <span class='op-status left'>TERMINAL BOOT <span>// 启动序列</span></span>
  <span class='op-status right'><i></i>LIVE <b>RL-AENTRO/26</b></span>
  <div class='opening-lens'>
    <svg class='op-ring' viewBox='0 0 400 400' fill='none'>
      <circle cx='200' cy='200' r='196' stroke='var(--rl-line-strong)' stroke-dasharray='2 6' />
      <circle class='op-arc' cx='200' cy='200' r='176' stroke='var(--rl-accent)' stroke-width='3' pathLength='1' />
      <circle cx='200' cy='200' r='150' stroke='var(--rl-line-strong)' />
      <path d='M200 0v22M200 378v22M0 200h22M378 200h22' stroke='currentColor' />
    </svg>
    <div class='opening-identity'>
      <!-- Exact mark paths from LBEILC/RhineLabUI src/brand.ts.
           Code license: /licenses/RhineLabUI-MIT.txt. Brand rights remain with their owners. -->
      <svg viewBox='0 0 310 145' fill='none' aria-hidden='true'>
        <path d='M156 75C127 48 103 15 70 15C37 15 15 39 15 70S38 128 70 128C103 128 127 96 176 52M155 75C182 99 208 128 240 128C273 128 295 105 295 73S273 15 240 15C221 15 207 23 192 38' stroke='currentColor' stroke-width='26' pathLength='1' />
        <path d='M44 70h50M69 45v50M219 70h44' stroke='currentColor' stroke-width='15' />
      </svg>
      <span class='opening-name'>AENTRO</span>
      <span class='opening-caption'>PERSONAL TERMINAL</span>
    </div>
  </div>
  <div class='op-load'>
    <span class='op-caution'><i></i>ACCESS LEVEL · PUBLIC</span>
    <span class='op-count'><small>LOADING</small><b id='opening-count'>000</b>%</span>
    <span class='opening-rule'></span>
  </div>
</div>

<script is:inline>
  (() => {
    const opening = document.getElementById('opening-sequence')
    if (!opening) return
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('aentro-opening-seen')) {
        opening.remove()
        return
      }
      sessionStorage.setItem('aentro-opening-seen', '1')
      const root = document.documentElement
      // The overlay is opaque until it fades, so the page backdrop can wait.
      root.classList.add('rl-booting')
      opening.classList.add('is-playing')
      const count = document.getElementById('opening-count')
      const start = performance.now()
      let shown = ''
      const step = (now) => {
        const t = Math.min(1, (now - start) / 1500)
        const next = String(Math.round((1 - Math.pow(1 - t, 3)) * 100)).padStart(3, '0')
        if (count && next !== shown) {
          shown = next
          count.textContent = next
        }
        if (t < 1 && opening.isConnected) requestAnimationFrame(step)
      }
      requestAnimationFrame(step)
      const finish = () => {
        opening.remove()
        root.classList.remove('rl-booting')
      }
      // Paint the page underneath before the overlay starts fading.
      setTimeout(() => root.classList.remove('rl-booting'), 1400)
      // CSS also hides the overlay, even if subsequent JS fails.
      setTimeout(finish, 2400)
      document.addEventListener('astro:before-swap', finish, { once: true })
    } catch {
      opening.remove()
      document.documentElement.classList.remove('rl-booting')
    }
  })()
</script>

<style>
  #opening-sequence {
    display: none; position: fixed; inset: 0; z-index: 10000; overflow: hidden; pointer-events: none;
    background: hsl(var(--background)); color: hsl(var(--foreground));
    background-image: radial-gradient(var(--rl-dot) 1px, transparent 1.3px);
    background-size: 22px 22px;
    font-family: var(--rl-mono);
    contain: layout paint;
  }
  #opening-sequence::before {
    content: ''; position: absolute; inset: 0;
    background: var(--rl-bars) right bottom / cover no-repeat; opacity: var(--rl-bars-opacity);
    -webkit-mask-image: linear-gradient(105deg, transparent 25%, #000 75%);
    mask-image: linear-gradient(105deg, transparent 25%, #000 75%);
    transform: translateZ(0);
  }
  #opening-sequence.is-playing { display: grid; place-items: center; animation: opening-exit .55s 1.75s ease-in-out forwards; }
  .op-corner { position: absolute; width: 22px; height: 22px; border: 0 solid var(--rl-line-strong); }
  .op-corner.tl { top: 18px; left: 18px; border-width: 1px 0 0 1px; border-color: var(--rl-accent); }
  .op-corner.tr { top: 18px; right: 18px; border-width: 1px 1px 0 0; }
  .op-corner.bl { bottom: 18px; left: 18px; border-width: 0 0 1px 1px; }
  .op-corner.br { bottom: 18px; right: 18px; border-width: 0 1px 1px 0; }
  .op-status { position: absolute; top: 24px; display: flex; align-items: center; gap: .55rem; font-size: .6rem; letter-spacing: .16em; color: hsl(var(--muted-foreground)); animation: op-fade .4s .1s both; }
  .op-status.left { left: 52px; }
  .op-status.left::before { content: ''; width: 6px; height: 6px; background: var(--rl-accent); }
  .op-status.right { right: 52px; }
  .op-status i { width: 6px; height: 6px; background: var(--rl-signal); }
  .op-status b { color: hsl(var(--foreground)); font-weight: 600; }
  .opening-lens { position: relative; display: grid; place-items: center; width: min(78vw, 400px); aspect-ratio: 1; }
  .op-ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: orbit-reveal 1.2s ease-out both; }
  .op-arc { stroke-dasharray: .22 .78; transform-origin: 200px 200px; animation: arc-sweep 1.7s cubic-bezier(.6, 0, .2, 1) both; }
  .opening-identity { display: flex; flex-direction: column; align-items: center; position: relative; }
  .opening-identity > svg { width: clamp(120px, 26vw, 170px); margin-bottom: 20px; contain: paint; }
  .opening-identity > svg path:first-child { stroke-dasharray: 1; animation: mark-draw 1.1s ease-out both; }
  .opening-name { padding: .1em .35em .15em; background: var(--rl-ink); color: var(--rl-paper); font-family: var(--rl-sans); font-size: clamp(1.6rem, 5vw, 2.4rem); font-weight: 800; letter-spacing: .2em; padding-left: .55em; clip-path: inset(0 100% 0 0); animation: plate-wipe .5s .55s cubic-bezier(.6, 0, .2, 1) forwards; }
  .opening-caption { margin-top: 10px; font-size: .62rem; letter-spacing: .32em; color: hsl(var(--muted-foreground)); animation: op-fade .4s .9s both; }
  .op-load { position: absolute; right: 7vw; bottom: 9vh; display: flex; flex-direction: column; align-items: flex-end; gap: .6rem; width: min(86vw, 300px); }
  .op-caution { display: flex; align-items: center; gap: .55rem; font-size: .56rem; font-weight: 700; letter-spacing: .16em; }
  .op-caution i { width: 26px; height: 8px; background: repeating-linear-gradient(-45deg, var(--rl-accent) 0 4px, var(--rl-ink) 4px 8px); }
  .op-count { display: flex; align-items: baseline; gap: .7rem; width: 100%; justify-content: space-between; font-size: .7rem; color: hsl(var(--muted-foreground)); }
  .op-count small { font-size: .58rem; letter-spacing: .2em; }
  .op-count b { margin-left: auto; font-size: 2.2rem; font-weight: 300; font-variant-numeric: tabular-nums; color: hsl(var(--foreground)); }
  .opening-rule { width: 100%; height: 2px; background: var(--rl-accent); transform-origin: left; animation: rule-reveal 1.5s cubic-bezier(.3, 0, .2, 1) both; }
  @keyframes mark-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes orbit-reveal { from { opacity: 0; transform: scale(.88) rotate(-25deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
  @keyframes arc-sweep { from { transform: rotate(-90deg); } to { transform: rotate(250deg); } }
  @keyframes plate-wipe { to { clip-path: inset(0); } }
  @keyframes rule-reveal { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes op-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes opening-exit { to { opacity: 0; visibility: hidden; } }
  @media (max-width: 640px) { .op-status { display: none; } }
  @media (prefers-reduced-motion: reduce) { #opening-sequence.is-playing { display: none; } }
</style>
