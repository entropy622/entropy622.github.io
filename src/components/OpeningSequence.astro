<!-- Decorative, fail-open introduction. Never locks scrolling or focus. -->
<div id='opening-sequence' aria-hidden='true' inert>
  <div class='opening-orbit'></div>
  <div class='opening-identity'>
    <!-- Exact mark paths from LBEILC/RhineLabUI src/brand.ts.
         Code license: /licenses/RhineLabUI-MIT.txt. Brand rights remain with their owners. -->
    <svg viewBox='0 0 310 145' fill='none' aria-hidden='true'>
      <path d='M156 75C127 48 103 15 70 15C37 15 15 39 15 70S38 128 70 128C103 128 127 96 176 52M155 75C182 99 208 128 240 128C273 128 295 105 295 73S273 15 240 15C221 15 207 23 192 38' stroke='currentColor' stroke-width='26' pathLength='1' />
      <path d='M44 70h50M69 45v50M219 70h44' stroke='currentColor' stroke-width='15' />
    </svg>
    <span class='opening-name'>AENTRO</span>
    <span class='opening-caption'>PERSONAL BLOG</span>
  </div>
  <div class='opening-rule'></div>
</div>

<script is:inline>
  (() => {
    const opening = document.getElementById('opening-sequence')
    if (!opening) return
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || sessionStorage.getItem('aentro-opening-seen')) {
        opening.remove()
        return
      }
      sessionStorage.setItem('aentro-opening-seen', '1')
      opening.classList.add('is-playing')
      // CSS also hides the overlay, even if subsequent JS fails.
      setTimeout(() => opening.remove(), 2400)
      document.addEventListener('astro:before-swap', () => opening.remove(), { once: true })
    } catch {
      opening.remove()
    }
  })()
</script>

<style>
  #opening-sequence { display: none; position: fixed; inset: 0; z-index: 10000; overflow: hidden; pointer-events: none; background: hsl(var(--background)); color: hsl(var(--foreground)); }
  #opening-sequence.is-playing { display: grid; place-items: center; animation: opening-exit .55s 1.65s ease-in-out forwards; }
  .opening-orbit { position: absolute; width: min(75vw, 640px); aspect-ratio: 1; border: 1px solid hsl(var(--border) / .55); border-radius: 50%; animation: orbit-reveal 1.7s ease-out both; }
  .opening-orbit::before, .opening-orbit::after { content: ''; position: absolute; inset: 15%; border: 1px solid hsl(var(--border) / .35); transform: rotate(45deg); }
  .opening-orbit::after { inset: -15%; border-radius: 50%; border-style: dashed; opacity: .4; }
  .opening-identity { display: flex; flex-direction: column; align-items: center; position: relative; }
  svg { width: clamp(150px, 30vw, 200px); margin-bottom: 25px; }
  svg path:first-child { stroke-dasharray: 1; animation: mark-draw 1.1s ease-out both; }
  .opening-name { font-size: clamp(2rem, 6vw, 3rem); font-weight: 750; letter-spacing: .22em; padding-left: .22em; }
  .opening-caption { margin-top: 8px; font-size: .65rem; letter-spacing: .3em; color: hsl(var(--muted-foreground)); }
  .opening-rule { position: absolute; inset: auto 7vw 10vh; height: 2px; background: var(--rhine-accent); transform-origin: left; animation: rule-reveal 1.6s ease-in-out both; }
  @keyframes mark-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes orbit-reveal { from { opacity: 0; transform: scale(.85) rotate(-20deg); } to { opacity: 1; transform: scale(1) rotate(0); } }
  @keyframes rule-reveal { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes opening-exit { to { opacity: 0; visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { #opening-sequence.is-playing { display: none; } }
</style>
