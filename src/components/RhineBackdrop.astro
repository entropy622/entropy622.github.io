<!-- Fixed decorative layer: graph paper, margin ruler, HUD frame. Never intercepts input. -->
<div class='rl-backdrop' aria-hidden='true'>
  <div class='rl-backdrop-paper'></div>
  <div class='rl-backdrop-ruler'></div>
</div>
<div class='rl-hud' aria-hidden='true'>
  <span class='rl-corner tl'></span><span class='rl-corner tr'></span>
  <span class='rl-corner bl'></span><span class='rl-corner br'></span>
  <span class='rl-hud-status left'>RHINE LAB STYLE <span>// 个人档案</span></span>
  <span class='rl-hud-status right'><i class='rl-status'></i>ONLINE <b>AE-ARCHIVE</b> <span id='rl-clock'></span></span>
  <span class='rl-hud-foot'>ACCESS · PUBLIC</span>
</div>

<script is:inline>
  (() => {
    const clock = document.getElementById('rl-clock')
    const pad = (n) => String(n).padStart(2, '0')
    const tick = () => {
      if (!clock) return
      const d = new Date()
      clock.textContent = `${d.getFullYear()}.${pad(d.getMonth() + 1)}.${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`
    }
    tick()
    setInterval(tick, 1000)
  })()
</script>
