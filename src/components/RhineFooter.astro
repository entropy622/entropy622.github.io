---
import { Icon } from 'astro-pure/user'
import RhineMark from '@/components/RhineMark.astro'
import config from '@/site-config'

const social = config.footer.social || []
const menu = config.header.menu ?? []
const year = new Date().getFullYear()
---

<footer class='rl-footer'>
  <div class='rl-rule' aria-hidden='true'></div>
  <div class='rl-footer-grid'>
    <div class='rl-footer-id'>
      <RhineMark />
      <div>
        <b>AENTRO</b>
        <span>回首空城 · 技术笔记、日常与作品</span>
      </div>
    </div>
    <nav class='rl-footer-nav' aria-label='页脚导航'>
      {menu.map((item, index) => (
        <a href={item.link}><span aria-hidden='true'>{String(index + 1).padStart(2, '0')}</span>{item.title}</a>
      ))}
    </nav>
    <div class='rl-footer-social'>
      {social.map(({ label, href, icon }) => (
        <a {href} rel='me' aria-label={label} title={label}><Icon name={icon} class='size-4' /></a>
      ))}
    </div>
  </div>
  <div class='rl-footer-base'>
    <span>© {year} {config.author}</span>
    <span aria-hidden='true'>FILE AE-{year} · CONFIDENTIALITY PUBLIC</span>
    <span class='rl-barcode' aria-hidden='true'></span>
  </div>
  <div class='rl-footer-mark' aria-hidden='true'>AENTRO</div>
</footer>
