---
interface Props { class?: string }
const { class: className } = Astro.props
---

<!-- Quiet orbital diagram around the homepage portrait: one open arc and a few satellites. -->
<svg class:list={['rhine-orbit', className]} viewBox='0 0 480 480' fill='none' aria-hidden='true' focusable='false'>
  <circle cx='240' cy='240' r='210' class='orbit-line' stroke-width='1.2' stroke-dasharray='1080 240' transform='rotate(38 240 240)' />
  <circle cx='240' cy='240' r='160' class='orbit-faint' stroke-width='1' stroke-dasharray='2 7' />
  <circle cx='405' cy='370' r='11' class='orbit-dot' />
  <circle cx='126' cy='342' r='4' class='orbit-signal' />
  <circle cx='300' cy='88' r='3.5' class='orbit-signal' />
</svg>

<style>
  .rhine-orbit { display: block; pointer-events: none; overflow: visible; }
  .orbit-line { stroke: var(--rl-ink); opacity: .55; }
  .orbit-faint { stroke: var(--rl-line-strong); }
  .orbit-dot { fill: var(--rl-ink); }
  .orbit-signal { fill: var(--rl-accent); }
</style>
