---
interface Props { title: string; label: string; number: string; description?: string }
const { title, label, number, description } = Astro.props
---
<header class='directory-heading'>
  <div class='directory-heading-main'>
    <a class='directory-back' href='/'>← INDEX <span aria-hidden='true'>/ {number}</span></a>
    <p class='rl-kicker directory-access' aria-hidden='true'>DIRECTORY // {label}</p>
    <h1><span class='directory-label'>{label}</span><span class='rl-plate directory-title-cn'>{title}</span></h1>
    {description && <p class='directory-desc'>{description}</p>}
  </div>
  <div class='directory-heading-art' aria-hidden='true'>
    <svg viewBox='0 0 200 200' fill='none'>
      <circle cx='100' cy='100' r='96' stroke='var(--rl-line-strong)' stroke-dasharray='2 5' />
      <circle cx='100' cy='100' r='80' stroke='var(--rl-line-strong)' />
      <circle cx='100' cy='100' r='80' stroke='var(--rl-accent)' stroke-width='3' stroke-dasharray='60 600' transform='rotate(-40 100 100)' />
      <path d='M100 4v14M100 182v14M4 100h14M182 100h14' stroke='var(--rl-ink)' />
    </svg>
    <span class='directory-number'>{number}</span>
    <span class='directory-file'>FILE · RL-{label.slice(0, 3)}-{number}</span>
  </div>
</header>
<div class='rl-rule directory-rule' aria-hidden='true'></div>
