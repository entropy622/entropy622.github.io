---
interface Props { title: string; label: string; number: string; description?: string }
const { title, label, number, description } = Astro.props
---
<header class='directory-heading'>
  <div class='directory-heading-main'>
    <a class='directory-back' href='/'>← INDEX <span aria-hidden='true'>/ {number}</span></a>
    <h1>
      <span class='directory-label rl-display'>{label}</span>
      <span class='rl-plate directory-title-cn'>{title}</span>
    </h1>
    {description && <p class='directory-desc'>{description}</p>}
  </div>
  <div class='directory-heading-art' aria-hidden='true'>
    <svg viewBox='0 0 200 200' fill='none'>
      <circle cx='100' cy='100' r='94' stroke='var(--rl-line-strong)' stroke-width='6' stroke-dasharray='1 8.844' />
      <circle cx='100' cy='100' r='94' stroke='var(--rl-ink)' stroke-width='10' stroke-dasharray='1.5 147.15' transform='rotate(-90 100 100)' />
      <circle cx='100' cy='100' r='78' stroke='var(--rl-line-strong)' />
      <circle cx='100' cy='100' r='78' stroke='var(--rl-accent)' stroke-width='3' stroke-dasharray='70 420' transform='rotate(-120 100 100)' />
      <circle cx='100' cy='100' r='60' stroke='var(--rl-line)' stroke-dasharray='2 5' />
    </svg>
    <span class='directory-number'>{number}</span>
    <span class='directory-file'>FILE · RL-{label.slice(0, 3)}-{number}</span>
  </div>
</header>
<div class='rl-rule directory-rule' aria-hidden='true'></div>
